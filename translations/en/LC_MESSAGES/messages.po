msgid "Interface admin de modération, déploiement sur serveur en ligne, ouverture des contributions publiques pour que Jackbeat vive vraiment au-delà du TP."
msgstr "An admin moderation interface, deployment to an online server, and public contributions so that Jackbeat truly lives on beyond the assignment."

#: templates/notre_histoire.html:588
msgid "Étape 8 — Bilinguisme & sécurité"
msgstr "Step 8 — Bilingualism & security"

#: templates/notre_histoire.html:588
